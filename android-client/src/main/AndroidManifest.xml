<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The radio lives on the agent, reached over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- API 37+: without this runtime permission an app cannot open connections to its local
         network, so an agent on the Wi-Fi is unreachable (the connect just times out). The
         emulator's 10.0.2.2 and adb-forwarded loopback do not need it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="false"
        android:label="RemoteBLE Client"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- singleTop: a pairing link opened while the app runs reaches it in onNewIntent rather
             than stacking a second copy on top. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An agent's pairing link (remoteble://host:port?token=…&fp=…), as a camera app opens it
                 from the agent's QR code. The app confirms before using it: any app can open a link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="remoteble" />
            </intent-filter>
        </activity>
    </application>
</manifest>
