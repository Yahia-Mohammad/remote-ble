<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>RemoteBLE Agent</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- This app drives CoreBluetooth as a central (never advertises/is a peripheral), so only
         the "central" background mode applies.

         It does more than keep existing links alive. Measured on hardware (Rig B case 3,
         docs/pr8-rig-b-evidence.md): while the app holds an active CoreBluetooth connection this
         mode keeps the *process* scheduled, so its Ktor accept loop keeps running and new inbound
         WebSocket connections are still accepted — 38/38 across 91 s backgrounded. A control run
         with no BLE link was suspended ~8 s after backgrounding. This comment previously claimed
         the opposite; do not restore that claim without re-measuring.

         Note the scan caveat: iOS ignores a `nil`-serviceUUIDs scan while backgrounded, and
         Kable's Apple scanner passes nil today, so a backgrounded agent may serve an existing
         link yet discover nothing. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
    </array>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>RemoteBLE Agent connects to nearby Bluetooth peripherals on behalf of remote clients.</string>
    <!-- The agent's own dashboard/WebSocket speak ws://http:// (cleartext), same as
         android-agent/ios-client's network exceptions. ATS already carves out localhost for
         free; a client on the same LAN reaching this phone's arbitrary IP needs a blanket
         exception, since ATS can't scope NSExceptionDomains to an IP picked at runtime.
         Dev/test app only — do not carry this into a shipping build. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- Compose Multiplatform's PlistSanityCheck throws (SIGABRT on launch) unless this key is
         present and true — without it Compose is capped to 60 Hz on high-refresh-rate iPhones.
         This is a hard launch-time failure, not a warning: see ComposeUIViewController's
         enforceStrictPlistSanityCheck. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
