<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>RemoteBLE Client</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- The agent speaks ws:// (cleartext), same as android-client's network_security_config.xml.
         ATS already carves out localhost/127.0.0.1 for free (Simulator-on-same-Mac needs nothing
         here); a physical device talking to an arbitrary LAN IP does need a blanket exception,
         since ATS can't scope NSExceptionDomains to an IP the user only picks at runtime. Dev/test
         app only — do not carry this into a shipping build. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- Required by Compose Multiplatform on iOS: without it the app aborts on launch with
         "CADisableMinimumFrameDurationOnPhone is not set to true" on any device with a display
         faster than 60 Hz. Same key, same reason, as ios-agent/Info.plist — the agent app hit this
         first (Rig B finding 2) and this app was left with the identical defect. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- Required of any app that instantiates a CBCentralManager: iOS terminates the process on
         first CoreBluetooth use if this key is absent. REMOTE mode never touches the radio — the
         agent owns it and this app only speaks WebSocket — which is why the app has shipped without
         the key. `peripheralFor(BleMode.LOCAL, …)` does touch it, so the key is a precondition for
         exercising the SDK's local path here at all. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>RemoteBLE uses Bluetooth to talk to nearby peripherals directly when running in local mode.</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
